{$APP_DOMAIN:localhost} {
    # SSE endpoint - flush immediately without buffering
    handle /api/events {
        reverse_proxy api:4000 {
            flush_interval -1
        }
    }

    # Standard REST API
    handle /api/* {
        reverse_proxy api:4000
    }

    # Static React SPA served by client container
    handle {
        reverse_proxy client:80
    }
}
